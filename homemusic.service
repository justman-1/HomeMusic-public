[Unit]
Description=HomeMusic production Docker Compose stack
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/srv/homemusic-app
ExecStart=/usr/bin/docker compose -f /srv/homemusic-app/docker-compose.prod.yml up -d
ExecStop=/usr/bin/docker compose -f /srv/homemusic-app/docker-compose.prod.yml down
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
