# Copy to .env and fill in. Never commit .env.

# --- Paths -------------------------------------------------------------------
# Windows folder with library/, staging/, .trash/, .backups/
MUSIC_ROOT=B:\Music

# --- Gateway -----------------------------------------------------------------
VPS_HOST=203.0.113.10
# Public URLs (Caddy on the VPS). Used by the Hub for links/QR and CORS.
PUBLIC_MUSIC_URL=https://203.0.113.10:8444
PUBLIC_HUB_URL=https://203.0.113.10:8445

# --- Navidrome ---------------------------------------------------------------
# Random string; Navidrome encrypts stored user passwords with it. Don't change after first start.
ND_PASSWORDENCRYPTIONKEY=
# Navidrome admin. The Hub uses it for library scans (startScan needs admin rights).
NAVIDROME_ADMIN_USER=admin
NAVIDROME_ADMIN_PASSWORD=

# --- Hub ---------------------------------------------------------------------
# Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
HUB_SECRET_KEY=
LOG_LEVEL=INFO
# Optional Netscape cookies exported for youtube.com (README, «YouTube просит проверку «не робот»»).
# Container path, e.g. /music/.youtube-cookies.txt; leave unset for anonymous downloads.
# YTDLP_COOKIES_FILE=/music/.youtube-cookies.txt
# Compose sets YTDLP_POT_BASE_URL=http://youtube-pot:4416 and persistent YTDLP_CACHE_DIR=/data/yt-dlp-cache.
# Outside Compose, point YTDLP_POT_BASE_URL at your local bgutil 2.0.2 server (no public port).
# Invite codes (admin → Пользователи → «Пригласить») are valid this many days by default.
INVITE_DAYS=7
# «Sign in with Google» in the app: the OAuth client id of the Web application type (README, «Вход через Google»).
# Empty — the app shows no Google button. Not a secret.
GOOGLE_CLIENT_ID=
# Registration by email without an invite: a code in a letter (README, «Регистрация по почте»). SMTP of any mailbox;
# Gmail: smtp.gmail.com, 587, the address and an app password (free, ~500 letters a day). Empty host — no such registration.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# the sender's address; empty — SMTP_USER
SMTP_FROM=
# at most this many letters in 24 hours (Gmail sends ~500), then registration asks to try tomorrow
EMAIL_DAILY_LIMIT=450

# --- «Микс дня» (MIXES.md 6) ---------------------------------------------------
# Last.fm API key (free: https://www.last.fm/api/account/create): similar tracks/artists, tags for mix names.
# Empty — mixes are built from the other sources.
LASTFM_API_KEY=
LASTFM_SHARED_SECRET=
LASTFM_APPLICATION_NAME=
LASTFM_REGISTERED_TO=
# Users' local time: the hour a mix is built at (the containers run in UTC).
TIMEZONE=Europe/Moscow

# --- Embedder (audio vectors on the GPU, MIXES.md 4.2) ---------------------------
# The Hub calls it inside the compose network. The token is optional (the port is not published).
EMBEDDER_URL=http://embedder:8090
EMBEDDER_TOKEN=

# --- Optional Soulseek source ------------------------------------------------
# Set SLSKD_URL=http://slskd:5030 and enable the soulseek Compose profile.
SLSKD_URL=
SLSKD_API_KEY=
SLSKD_SLSK_USERNAME=
SLSKD_SLSK_PASSWORD=
# Optional overrides for a slow or unavailable Soulseek server endpoint.
# SLSKD_SLSK_PORT=2242
# SLSKD_SLSK_CONNECTION_TIMEOUT=15000

# --- AI (any OpenAI-compatible API) ------------------------------------------
# OpenRouter: https://openrouter.ai/keys
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=anthropic/claude-haiku-5.5
# USD per 1M tokens, for cost logging
LLM_PRICE_IN=0.10
LLM_PRICE_OUT=0.50
# Fallback: local Ollama (RTX 5060 Ti 16 GB is enough for qwen3-vl:8b)
# LLM_BASE_URL=http://host.docker.internal:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=qwen3-vl:8b

# --- Optional outbound proxy for selected hosts and media providers -----------
# OUTBOUND_PROXY=http://host.docker.internal:3128
# OUTBOUND_PROXY_HOSTS=api.deezer.com,openrouter.ai
# Add youtube.com and/or soundcloud.com to proxy the corresponding provider.
