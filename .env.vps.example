# Copy to .env on the VPS. Never commit the resulting .env.

# Linux host path. The production compose file mounts this directory into containers.
MUSIC_ROOT=/srv/homemusic

# Public HTTPS endpoints served by Caddy.
PUBLIC_MUSIC_URL=https://music.example.com
PUBLIC_HUB_URL=https://hub.example.com

# Navidrome secrets. Generate unique values before first start and do not change them later.
# Example: openssl rand -base64 32 | tr -d '=+/' | cut -c1-32
ND_PASSWORDENCRYPTIONKEY=CHANGE_ME_NAVIDROME_ENCRYPTION_KEY
NAVIDROME_ADMIN_USER=admin
NAVIDROME_ADMIN_PASSWORD=CHANGE_ME_NAVIDROME_PASSWORD

# Hub Fernet key. Generate with:
# python3 -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
HUB_SECRET_KEY=CHANGE_ME_FERNET_KEY

LOG_LEVEL=INFO
INVITE_DAYS=7
TIMEZONE=Europe/Moscow

# Optional Google login. Leave empty to disable it.
GOOGLE_CLIENT_ID=

# Optional email registration. Leave SMTP_HOST empty to disable it.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
EMAIL_DAILY_LIMIT=450

# Last.fm improves similar-track and similar-artist recommendations.
# Create a free key at https://www.last.fm/api/account/create
LASTFM_API_KEY=

# Optional Navidrome Last.fm scrobbling. Requires the Last.fm API key and shared secret.
# Add these two variables to docker-compose.prod.yml under navidrome.environment if enabled.
ND_LASTFM_APIKEY=
ND_LASTFM_SECRET=

# CPU MuQ-MuLan audio embedder.
# It is used for audio similarity; no LLM API is required for recommendations.
EMBEDDER_URL=http://embedder:8090
EMBEDDER_TOKEN=
EMBEDDER_DEVICE=cpu
EMBEDDER_CPU_THREADS=2
EMBEDDER_DOWNLOADS=2
EMBEDDER_CLIP_BATCH=2
EMBEDDER_IDLE_UNLOAD_S=300
EMBEDDER_MEM_LIMIT=7g
EMBEDDER_MEMSWAP_LIMIT=8g

# Optional outbound proxy for selected media providers.
OUTBOUND_PROXY=
OUTBOUND_PROXY_HOSTS=

# Soulseek is disabled unless all values are filled and the service profile is enabled.
SLSKD_API_KEY=
SLSKD_SLSK_USERNAME=
SLSKD_SLSK_PASSWORD=

# LLM is not needed for mixes, taste, statistics, or audio similarity.
# Fill these only if the optional assistant or AI-generated mix names are needed.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=
LLM_PRICE_IN=0
LLM_PRICE_OUT=0
